# =================================================================
# AI INTRADAY TRADING AGENT INDIA — ENVIRONMENT CONFIGURATION
# =================================================================
# SAFETY RULE: PAPER TRADING ONLY. REAL-MONEY ORDERS STRICTLY DISABLED.
# =================================================================

# Operational Mode
TRADING_MODE=PAPER
IS_PAPER_TRADING=true

# Market Data Provider: "zerodha", "upstox", "angelone", "historical", "mock"
MARKET_DATA_PROVIDER=mock

# -----------------------------------------------------------------
# 1. ZERODHA KITE CONNECT API (Optional for Real Market Data Feed)
# -----------------------------------------------------------------
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here

# -----------------------------------------------------------------
# 2. UPSTOX API V2 (Optional for Real Market Data Feed)
# -----------------------------------------------------------------
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# -----------------------------------------------------------------
# 3. ANGEL ONE SMARTAPI (Optional for Real Market Data Feed)
# -----------------------------------------------------------------
ANGELONE_API_KEY=your_angelone_api_key_here
ANGELONE_CLIENT_CODE=your_client_code_here
ANGELONE_PIN=your_mpin_here
ANGELONE_TOTP_SECRET=your_totp_secret_here
ANGELONE_JWT_TOKEN=your_jwt_token_here

# -----------------------------------------------------------------
# 4. EXTERNAL NEWS & GLOBAL DATA APIS (Optional)
# -----------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here
GLOBAL_DATA_API_KEY=your_global_data_api_key_here

# -----------------------------------------------------------------
# 5. RISK PARAMETERS & GUARDRAILS
# -----------------------------------------------------------------
INITIAL_CAPITAL=100000.0
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_AMOUNT=3000.0
MAX_OPEN_POSITIONS=3
TRADING_CUTOFF_TIME=15:15
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
DATA_FRESHNESS_MAX_SECONDS=300
